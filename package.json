{
  "name": "spacechat",
  "version": "0.0.3",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cordova": "vite build --mode cordova",
    "cordova:prepare": "pnpm build:cordova && rm -rf www && cp -R dist www && cordova prepare",
    "cordova:add:android": "cordova platform add android",
    "cordova:add:ios": "cordova platform add ios",
    "cordova:run:android": "pnpm cordova:prepare && cordova run android",
    "cordova:run:ios": "pnpm cordova:prepare && cordova run ios",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "cordova": "^13.0.0",
    "cordova-android": "13.0.0",
    "daisyui": "^5.7.50",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.13"
  },
  "cordova": {
    "platforms": [
      "android"
    ]
  }
}
